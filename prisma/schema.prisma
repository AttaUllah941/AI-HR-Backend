  uploadedBy User?      @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  candidate  Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([companyId, category])
  @@index([companyId, updatedAt])
  @@index([employeeId])
  @@index([candidateId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("stored_files")
}

model SearchBookmark {
  id         String   @id @default(cuid())
  userId     String
  title      String
  route      String
  entityType String?
  entityId   String   @default("")
  query      String?
  icon       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@unique([userId, route, entityId])
  @@map("search_bookmarks")
}

model RecentSearch {
  id          String   @id @default(cuid())
  userId      String
  query       String
  types       String[] @default([])
  filters     Json?
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("recent_searches")
}

model CompanySecurityPolicy {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  maxFailedLogins            Int      @default(5)
  lockoutMinutes             Int      @default(15)
  passwordMinLength          Int      @default(8)
  passwordRequireLetter      Boolean  @default(true)
  passwordRequireNumber      Boolean  @default(true)
  passwordRequireSpecial     Boolean  @default(false)
  requireMfaForPrivileged    Boolean  @default(false)
  allowSelfRegistration      Boolean  @default(true)
  refreshRateLimitPerWindow  Int      @default(60)
  ipAllowlist                Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_security_policies")
}

model LoginAttempt {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  email      String
  success    Boolean
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, success, createdAt])
  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}
