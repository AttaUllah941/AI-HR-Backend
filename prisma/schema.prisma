// Zenith Enterprise AI HR — Phase 1 foundation schema
// Auth/RBAC skeleton; domain modules expand in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DELETED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Company {
  id          String    @id @default(cuid())
  name        String
  legalName   String?
  email       String?
  phone       String?
  website     String?
  logoUrl     String?
  timezone    String    @default("UTC")
  locale      String    @default("en-US")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users         User[]
  branches      Branch[]
  departments   Department[]
  teams         Team[]
  designations  Designation[]
  employees     Employee[]
  shifts        Shift[]
  holidays      Holiday[]
  attendanceRecords AttendanceRecord[]
  overtimeRequests  OvertimeRequest[]
  leaveTypes        LeaveType[]
  leavePolicies     LeavePolicy[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  salaryComponents  SalaryComponent[]
  salaryStructures  SalaryStructure[]
  taxSettings       TaxSetting[]
  payrollRuns       PayrollRun[]
  payrollEntries    PayrollEntry[]
  payslips          Payslip[]
  jobOpenings       JobOpening[]
  candidates        Candidate[]
  applications      JobApplication[]
  interviews        Interview[]
  jobOffers         JobOffer[]
  performanceGoals  PerformanceGoal[]
  performanceKpis   PerformanceKpi[]
  employeeKpis      EmployeeKpi[]
  reviewCycles      ReviewCycle[]
  performanceReviews PerformanceReview[]
  performanceFeedbacks PerformanceFeedback[]
  promotionRequests PromotionRequest[]
  aiUsageLogs       AiUsageLog[]
  aiConversations   AiConversation[]
  aiGenerations     AiGeneration[]
  reportExportLogs  ReportExportLog[]
  notifications     Notification[]
  notificationTemplates NotificationTemplate[]
  notificationPreferences NotificationPreference[]
  pushDevices       PushDevice[]
  settings          CompanySettings?
  storedFiles       StoredFile[]
  securityPolicy    CompanySecurityPolicy?
  loginAttempts     LoginAttempt[]

  @@index([deletedAt, isActive])
  @@map("companies")
}

model User {
  id                String     @id @default(cuid())
  companyId         String?
  email             String     @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  avatarUrl         String?
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?
  mfaEnabled        Boolean    @default(false)
  mfaSecret         String?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  company             Company?             @relation(fields: [companyId], references: [id])
  employee            Employee?
  userRoles           UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  emailTokens         EmailVerificationToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  aiUsageLogs         AiUsageLog[]
  aiConversations     AiConversation[]
  aiGenerations       AiGeneration[]
  reportExportLogs    ReportExportLog[]
  notifications       Notification[]
  notificationPreferences NotificationPreference[]
  pushDevices         PushDevice[]
  preference          UserPreference?
  uploadedFiles       StoredFile[]          @relation("FileUploader")
  searchBookmarks     SearchBookmark[]
  recentSearches      RecentSearch[]
  loginAttempts       LoginAttempt[]
  failedLoginCount    Int                   @default(0)
  lockedUntil         DateTime?

  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([companyId, status])
  @@index([companyId, mfaEnabled])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Session {
  id               String        @id @default(cuid())
  userId           String
  refreshTokenHash String
  status           SessionStatus @default(ACTIVE)
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([status])
  @@index([status, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Branch {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  code         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  phone        String?
  email        String?
  isHeadOffice Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments Department[]
  employees   Employee[]
  allowedIps  BranchAllowedIp[]
  jobOpenings JobOpening[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([deletedAt])
  @@map("branches")
}

model BranchAllowedIp {
  id        String   @id @default(cuid())
  branchId  String
  cidr      String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, cidr])
  @@index([branchId])
  @@map("branch_allowed_ips")
}

model Department {
  id          String    @id @default(cuid())
  companyId   String
  branchId    String?
  parentId    String?
  name        String
  code        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent   Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")
  teams    Team[]
  employees Employee[]
  jobOpenings JobOpening[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("departments")
}

model Team {
  id           String    @id @default(cuid())
  companyId    String
  departmentId String
  name         String
  code         String
  description  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("teams")
}

model Designation {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  code        String
  level       Int       @default(1)
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  jobOpenings JobOpening[]
  promotionRequests PromotionRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([level])
  @@index([deletedAt])
  @@map("designations")
}

enum EmployeeStatus {
  DRAFT
  ACTIVE
  ON_LEAVE
  PROBATION
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model Employee {
  id               String           @id @default(cuid())
  companyId        String
  userId           String?          @unique
  employeeCode     String
  firstName        String
  lastName         String
  email            String
  phone            String?
  personalEmail    String?
  dateOfBirth      DateTime?
  gender           Gender?
  nationality      String?
  maritalStatus    String?
  avatarUrl        String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  branchId         String?
  departmentId     String?
  teamId           String?
  designationId    String?
  managerId        String?
  employmentType   EmploymentType   @default(FULL_TIME)
  status           EmployeeStatus   @default(DRAFT)
  joinDate         DateTime?
  probationEndDate DateTime?
  confirmationDate DateTime?
  exitDate         DateTime?
  workLocation     String?
  bio              String?
  notes            String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch            Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department        Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team              Team?                      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  designation       Designation?               @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager           Employee?                  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports     Employee[]                 @relation("EmployeeManager")
  emergencyContacts EmployeeEmergencyContact[]
  education         EmployeeEducation[]
  experience        EmployeeExperience[]
  skills            EmployeeSkill[]
  certifications    EmployeeCertification[]
  documents         EmployeeDocument[]
  storedFiles       StoredFile[]
  attendanceRecords AttendanceRecord[]
  overtimeRequests  OvertimeRequest[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  salaryStructures  SalaryStructure[]
  payrollEntries    PayrollEntry[]
  payslips          Payslip[]
  managedJobOpenings JobOpening[] @relation("JobHiringManager")
  interviewsAsInterviewer Interview[] @relation("InterviewInterviewer")
  performanceGoals   PerformanceGoal[]
  employeeKpis       EmployeeKpi[]
  reviewsAsSubject   PerformanceReview[] @relation("ReviewSubject")
  reviewsAsReviewer  PerformanceReview[] @relation("ReviewReviewer")
  feedbackGiven      PerformanceFeedback[] @relation("FeedbackFrom")
  feedbackReceived   PerformanceFeedback[] @relation("FeedbackTo")
  promotionRequests  PromotionRequest[]

  @@unique([companyId, employeeCode])
  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, deletedAt])
  @@index([branchId])
  @@index([departmentId])
  @@index([teamId])
  @@index([designationId])
  @@index([managerId])
  @@index([deletedAt])
  @@map("employees")
}

model EmployeeEmergencyContact {
  id           String    @id @default(cuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

model EmployeeEducation {
  id           String    @id @default(cuid())
  employeeId   String
  institution  String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  grade        String?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_education")
}

model EmployeeExperience {
  id          String    @id @default(cuid())
  employeeId  String
  companyName String
  title       String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_experience")
}

model EmployeeSkill {
  id         String    @id @default(cuid())
  employeeId String
  name       String
  level      String?
  years      Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, name])
  @@index([employeeId])
  @@map("employee_skills")
}

model EmployeeCertification {
  id           String    @id @default(cuid())
  employeeId   String
  name         String
  issuer       String?
  credentialId String?
  issuedDate   DateTime?
  expiryDate   DateTime?
  documentUrl  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_certifications")
}

model EmployeeDocument {
  id         String    @id @default(cuid())
  employeeId String
  title      String
  category   String
  fileName   String?
  fileUrl    String?
  mimeType   String?
  fileSize   Int?
  uploadedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, deletedAt])
  @@map("employee_documents")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
  REMOTE
  EARLY_LEAVE
}

enum AttendanceSource {
  CLOCK
  MANUAL
  SYSTEM
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

model Shift {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  code          String
  startTime     String
  endTime       String
  breakMinutes  Int       @default(60)
  graceMinutes  Int       @default(15)
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([deletedAt])
  @@map("shifts")
}

model Holiday {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  date        DateTime
  isOptional  Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
  @@index([deletedAt])
  @@map("holidays")
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  companyId       String
  employeeId      String
  date            DateTime
  shiftId         String?
  checkInAt       DateTime?
  checkOutAt      DateTime?
  checkInIp       String?
  checkOutIp      String?
  status          AttendanceStatus @default(ABSENT)
  workMinutes     Int              @default(0)
  overtimeMinutes Int              @default(0)
  lateMinutes     Int              @default(0)
  notes           String?
  source          AttendanceSource @default(MANUAL)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  overtimeRequests OvertimeRequest[]

  @@unique([companyId, employeeId, date])
  @@index([companyId, date])
  @@index([employeeId, date])
  @@index([status])
  @@index([deletedAt])
  @@map("attendance_records")
}

model OvertimeRequest {
  id           String         @id @default(cuid())
  companyId    String
  employeeId   String
  attendanceId String?
  date         DateTime
  minutes      Int
  reason       String?
  status       OvertimeStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance AttendanceRecord? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([employeeId, date])
  @@index([deletedAt])
  @@map("overtime_requests")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveDayType {
  FULL_DAY
  HALF_DAY_AM
  HALF_DAY_PM
}

model LeaveType {
  id               String    @id @default(cuid())
  companyId        String
  name             String
  code             String
  description      String?
  color            String    @default("#3b82f6")
  isPaid           Boolean   @default(true)
  requiresApproval Boolean   @default(true)
  allowHalfDay     Boolean   @default(true)
  maxDaysPerYear   Int       @default(0)
  carryForwardDays Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([deletedAt])
  @@map("leave_types")
}

model LeavePolicy {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  allowNegativeBalance Boolean  @default(false)
  countWeekends        Boolean  @default(false)
  countHolidays        Boolean  @default(false)
  minNoticeDays        Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("leave_policies")
}

model LeaveBalance {
  id             String   @id @default(cuid())
  companyId      String
  employeeId     String
  leaveTypeId    String
  year           Int
  entitled       Float    @default(0)
  used           Float    @default(0)
  pending        Float    @default(0)
  carriedForward Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([companyId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id           String             @id @default(cuid())
  companyId    String
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  dayType      LeaveDayType       @default(FULL_DAY)
  days         Float
  reason       String?
  status       LeaveRequestStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([employeeId, startDate])
  @@index([leaveTypeId])
  @@index([deletedAt])
  @@map("leave_requests")
}

enum SalaryComponentKind {
  ALLOWANCE
  DEDUCTION
  BONUS
  TAX
}

enum SalaryCalcType {
  FIXED
  PERCENT_OF_BASIC
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  COMPLETED
  APPROVED
  PAID
  CANCELLED
}

enum PayslipStatus {
  GENERATED
  PAID
  VOID
}

model SalaryComponent {
  id            String              @id @default(cuid())
  companyId     String
  name          String
  code          String
  kind          SalaryComponentKind
  calcType      SalaryCalcType      @default(FIXED)
  defaultValue  Float               @default(0)
  isTaxable     Boolean             @default(true)
  isActive      Boolean             @default(true)
  description   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  structureItems   SalaryStructureItem[]
  entryLines       PayrollEntryLine[]

  @@unique([companyId, code])
  @@index([companyId, kind])
  @@index([deletedAt])
  @@map("salary_components")
}

model SalaryStructure {
  id           String    @id @default(cuid())
  companyId    String
  employeeId   String
  basicSalary  Float
  currency     String    @default("USD")
  effectiveFrom DateTime
  effectiveTo  DateTime?
  bankName     String?
  bankAccount  String?
  bankIban     String?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
