NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL (Docker Compose default)
DATABASE_URL=postgresql://zenith:zenith@localhost:5432/zenith_hr?schema=public

# JWT — replace with strong secrets in every environment
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS / frontend (comma-separated). In development, any localhost/127.0.0.1 port is also allowed.
CORS_ORIGIN=http://localhost:4200
APP_URL=http://localhost:4200

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Logging
LOG_LEVEL=info

# AI (server-side only — never expose keys to Angular)
# mock = deterministic heuristic responses (default, no key required)
# openai = OpenAI-compatible Chat Completions API
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Email (server-side only)
# console = log-only sink (default, safe for local/CI)
# smtp = POST JSON to EMAIL_SMTP_URL relay (from/to/subject/text/html)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@zenith.local
EMAIL_SMTP_URL=
EMAIL_API_KEY=

# Files (local disk; company Settings → Storage can note cloud providers)
FILE_STORAGE_ROOT=uploads
FILE_MAX_BYTES=10485760
