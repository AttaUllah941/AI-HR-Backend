# Copy to `.env.production` and replace every placeholder before deploy.
# Never commit real secrets.
#
# Generate JWTs:
#   openssl rand -hex 32

NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# Postgres (compose service DNS name is `postgres`)
# Compose builds DATABASE_URL from these — keep password in sync.
POSTGRES_USER=zenith
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=zenith_hr
DATABASE_URL=postgresql://zenith:CHANGE-ME-strong-db-password@postgres:5432/zenith_hr?schema=public

# JWT — must be unique, >= 32 chars, and not contain weak markers
# (change-me, example, replace-with, placeholder, …). Startup refuses otherwise.
JWT_ACCESS_SECRET=CHANGE-ME-use-openssl-rand-hex-32-for-access-token
JWT_REFRESH_SECRET=CHANGE-ME-use-openssl-rand-hex-32-for-refresh-token
# Required in production: 32 bytes (openssl rand -hex 32). Encrypts MFA secrets at rest. Do not rotate without re-enrolling MFA.
MFA_ENCRYPTION_KEY=CHANGE-ME-use-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public browser origins (comma-separated). Include the web app URL only.
CORS_ORIGIN=https://hr.example.com
APP_URL=https://hr.example.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOG_LEVEL=info
# Set LOG_TO_FILE=true to also write Winston files under /app/logs
LOG_TO_FILE=false

AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Use smtp in production; console is refused at startup unless ALLOW_CONSOLE_EMAIL=true (staging only)
EMAIL_PROVIDER=smtp
ALLOW_CONSOLE_EMAIL=false
EMAIL_FROM=noreply@example.com
EMAIL_SMTP_URL=
EMAIL_API_KEY=

FILE_STORAGE_ROOT=/app/uploads
FILE_MAX_BYTES=10485760

# Host publish ports (base compose / local). Production overlay unpublishes API + Postgres.
WEB_PORT=8080
