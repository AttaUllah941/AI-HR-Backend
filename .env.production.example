# Copy to `.env.production` and replace every placeholder before deploy.
# Never commit real secrets.

NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# Postgres (compose service DNS name is `postgres`)
POSTGRES_USER=zenith
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=zenith_hr
DATABASE_URL=postgresql://zenith:replace-with-strong-db-password@postgres:5432/zenith_hr?schema=public

# JWT — must be unique, >= 32 chars, and not contain weak markers (change-me, example, …)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public browser origins (comma-separated). Include the web app URL only.
CORS_ORIGIN=https://hr.example.com
APP_URL=https://hr.example.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOG_LEVEL=info

AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
EMAIL_SMTP_URL=
EMAIL_API_KEY=

FILE_STORAGE_ROOT=/app/uploads
FILE_MAX_BYTES=10485760

# Host publish ports (compose)
API_PORT=3000
WEB_PORT=8080
